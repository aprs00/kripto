[Unit]
Description=kripto Binance liquidation-print collector (one public read-only websocket; non-backfillable data, backlog LQ1)
[Service]
Type=simple
WorkingDirectory=%h/kripto
ExecStart=%h/kripto/.venv/bin/python -m kripto.liq
Restart=always
RestartSec=30
Nice=10
MemoryMax=250M
[Install]
WantedBy=default.target
